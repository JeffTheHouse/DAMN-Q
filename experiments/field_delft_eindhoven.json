{
  "schema_version": "1.0",
  "name": "Delft–Eindhoven · Real Fibre Route Proxy",
  "description": "Four published fibre segments via Utrecht, Nieuwegein and Den Bosch. Route-loss and latency baseline with ideal memories and local gates. Source: Avis et al. (2023), doi:10.1038/s41534-023-00765-x.",
  "run": {"until": 240000, "seed": 42, "tick_duration_s": 1e-06},
  "components": [
    {"id": "utrecht_pair_proxy", "type": "source", "params": {"delay": 200, "type": 2}, "position": {"x": 260, "y": 5}},
    {"id": "den_bosch_pair_proxy", "type": "source", "params": {"delay": 200, "type": 2}, "position": {"x": 500, "y": 5}},
    {"id": "delft_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 20, "y": 110}},
    {"id": "nieuwegein_left_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 260, "y": 110}},
    {"id": "nieuwegein_right_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 500, "y": 110}},
    {"id": "eindhoven_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 740, "y": 110}},
    {"id": "nieuwegein_bell_measurement", "type": "entanglement_swapper", "params": {"delay": 1, "visibility": 1}, "position": {"x": 260, "y": 215}},
    {"id": "nieuwegein_controller", "type": "orchestrator", "params": {"delay": 0}, "position": {"x": 500, "y": 215}},
    {"id": "eindhoven_correction", "type": "pauli_corrector", "params": {"delay": 0}, "position": {"x": 740, "y": 215}},
    {"id": "delft_probe", "type": "endpoint_probe", "params": {}, "position": {"x": 20, "y": 215}},
    {"id": "eindhoven_probe", "type": "endpoint_probe", "params": {}, "position": {"x": 740, "y": 320}}
  ],
  "connections": [
    {"from": {"component": "utrecht_pair_proxy", "port": "out_ch_1"}, "to": {"component": "delft_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 83, "attenuation_db_per_km": 0.2, "coupling_loss_db": 0},
    {"from": {"component": "utrecht_pair_proxy", "port": "out_ch_2"}, "to": {"component": "nieuwegein_left_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 19, "attenuation_db_per_km": 0.2, "coupling_loss_db": 0},
    {"from": {"component": "den_bosch_pair_proxy", "port": "out_ch_1"}, "to": {"component": "nieuwegein_right_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 75, "attenuation_db_per_km": 0.2, "coupling_loss_db": 0},
    {"from": {"component": "den_bosch_pair_proxy", "port": "out_ch_2"}, "to": {"component": "eindhoven_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 50, "attenuation_db_per_km": 0.2, "coupling_loss_db": 0},
    {"from": {"component": "nieuwegein_left_memory", "port": "ch_out_q"}, "to": {"component": "nieuwegein_bell_measurement", "port": "ch_in_q_1"}, "delay": 0},
    {"from": {"component": "nieuwegein_right_memory", "port": "ch_out_q"}, "to": {"component": "nieuwegein_bell_measurement", "port": "ch_in_q_2"}, "delay": 0},
    {"from": {"component": "nieuwegein_left_memory", "port": "ch_out_c"}, "to": {"component": "nieuwegein_controller", "port": "ch_in_memory_1"}, "delay": 0},
    {"from": {"component": "nieuwegein_right_memory", "port": "ch_out_c"}, "to": {"component": "nieuwegein_controller", "port": "ch_in_memory_2"}, "delay": 0},
    {"from": {"component": "nieuwegein_controller", "port": "ch_out_memory_1"}, "to": {"component": "nieuwegein_left_memory", "port": "ch_in_c"}, "delay": 0},
    {"from": {"component": "nieuwegein_controller", "port": "ch_out_memory_2"}, "to": {"component": "nieuwegein_right_memory", "port": "ch_in_c"}, "delay": 0},
    {"from": {"component": "delft_memory", "port": "ch_out_paired_memory"}, "to": {"component": "nieuwegein_left_memory", "port": "ch_in_paired_memory"}, "delay": 510},
    {"from": {"component": "nieuwegein_left_memory", "port": "ch_out_paired_memory"}, "to": {"component": "delft_memory", "port": "ch_in_paired_memory"}, "delay": 510},
    {"from": {"component": "nieuwegein_right_memory", "port": "ch_out_paired_memory"}, "to": {"component": "eindhoven_memory", "port": "ch_in_paired_memory"}, "delay": 625},
    {"from": {"component": "eindhoven_memory", "port": "ch_out_paired_memory"}, "to": {"component": "nieuwegein_right_memory", "port": "ch_in_paired_memory"}, "delay": 625},
    {"from": {"component": "nieuwegein_bell_measurement", "port": "ch_out_c_1"}, "to": {"component": "delft_memory", "port": "ch_in_c"}, "delay": 510},
    {"from": {"component": "nieuwegein_bell_measurement", "port": "ch_out_c_2"}, "to": {"component": "eindhoven_correction", "port": "ch_in_es"}, "delay": 625},
    {"from": {"component": "eindhoven_memory", "port": "ch_out_q"}, "to": {"component": "eindhoven_correction", "port": "ch_in_q"}, "delay": 0},
    {"from": {"component": "eindhoven_memory", "port": "ch_out_c"}, "to": {"component": "eindhoven_correction", "port": "ch_in_memory"}, "delay": 0},
    {"from": {"component": "eindhoven_correction", "port": "ch_out_memory"}, "to": {"component": "eindhoven_memory", "port": "ch_in_c"}, "delay": 0},
    {"from": {"component": "delft_memory", "port": "ch_out_q"}, "to": {"component": "delft_probe", "port": "ch_in_q"}, "delay": 0},
    {"from": {"component": "eindhoven_correction", "port": "ch_out_q"}, "to": {"component": "eindhoven_probe", "port": "ch_in_q"}, "delay": 0}
  ],
  "measurements": [
    {"type": "bell_fidelity", "probes": ["delft_probe", "eindhoven_probe"]}
  ]
}
