{
  "schema_version": "1.0",
  "name": "Hefei Field Experiment · Optical Swap Proxy",
  "description": "Published 14.7 km and 10.6 km links into Eve, reported fibre loss and visibility. A memory-assisted proxy with calibrated fidelity. Source: Sun et al. (2017), doi:10.1103/PhysRevA.95.032306.",
  "run": {"until": 20000, "seed": 42, "tick_duration_s": 1e-06},
  "components": [
    {"id": "alice_source", "type": "source", "params": {"delay": 200, "type": 2}, "position": {"x": 260, "y": 5}},
    {"id": "bob_source", "type": "source", "params": {"delay": 200, "type": 2}, "position": {"x": 500, "y": 5}},
    {"id": "alice_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 20, "y": 110}},
    {"id": "eve_left_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 260, "y": 110}},
    {"id": "eve_right_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 500, "y": 110}},
    {"id": "bob_memory", "type": "quantum_memory", "params": {"depolarization_p": 0.0, "delay": 0, "capacity": 100, "fifo": 1}, "position": {"x": 740, "y": 110}},
    {"id": "eve_bell_measurement", "type": "entanglement_swapper", "params": {"delay": 1, "visibility": 0.799}, "position": {"x": 260, "y": 215}},
    {"id": "eve_controller", "type": "orchestrator", "params": {"delay": 0}, "position": {"x": 500, "y": 215}},
    {"id": "bob_correction", "type": "pauli_corrector", "params": {"delay": 0}, "position": {"x": 740, "y": 215}},
    {"id": "alice_probe", "type": "endpoint_probe", "params": {}, "position": {"x": 20, "y": 215}},
    {"id": "bob_probe", "type": "endpoint_probe", "params": {}, "position": {"x": 740, "y": 320}}
  ],
  "connections": [
    {"from": {"component": "alice_source", "port": "out_ch_1"}, "to": {"component": "alice_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 0, "attenuation_db_per_km": 0, "coupling_loss_db": 0},
    {"from": {"component": "alice_source", "port": "out_ch_2"}, "to": {"component": "eve_left_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 14.7, "attenuation_db_per_km": 0, "coupling_loss_db": 3},
    {"from": {"component": "bob_source", "port": "out_ch_1"}, "to": {"component": "eve_right_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 10.6, "attenuation_db_per_km": 0, "coupling_loss_db": 6},
    {"from": {"component": "bob_source", "port": "out_ch_2"}, "to": {"component": "bob_memory", "port": "ch_in_q"}, "delay": 0, "length_km": 0, "attenuation_db_per_km": 0, "coupling_loss_db": 0},
    {"from": {"component": "eve_left_memory", "port": "ch_out_q"}, "to": {"component": "eve_bell_measurement", "port": "ch_in_q_1"}, "delay": 0},
    {"from": {"component": "eve_right_memory", "port": "ch_out_q"}, "to": {"component": "eve_bell_measurement", "port": "ch_in_q_2"}, "delay": 0},
    {"from": {"component": "eve_left_memory", "port": "ch_out_c"}, "to": {"component": "eve_controller", "port": "ch_in_memory_1"}, "delay": 0},
    {"from": {"component": "eve_right_memory", "port": "ch_out_c"}, "to": {"component": "eve_controller", "port": "ch_in_memory_2"}, "delay": 0},
    {"from": {"component": "eve_controller", "port": "ch_out_memory_1"}, "to": {"component": "eve_left_memory", "port": "ch_in_c"}, "delay": 0},
    {"from": {"component": "eve_controller", "port": "ch_out_memory_2"}, "to": {"component": "eve_right_memory", "port": "ch_in_c"}, "delay": 0},
    {"from": {"component": "alice_memory", "port": "ch_out_paired_memory"}, "to": {"component": "eve_left_memory", "port": "ch_in_paired_memory"}, "delay": 74},
    {"from": {"component": "eve_left_memory", "port": "ch_out_paired_memory"}, "to": {"component": "alice_memory", "port": "ch_in_paired_memory"}, "delay": 74},
    {"from": {"component": "eve_right_memory", "port": "ch_out_paired_memory"}, "to": {"component": "bob_memory", "port": "ch_in_paired_memory"}, "delay": 53},
    {"from": {"component": "bob_memory", "port": "ch_out_paired_memory"}, "to": {"component": "eve_right_memory", "port": "ch_in_paired_memory"}, "delay": 53},
    {"from": {"component": "eve_bell_measurement", "port": "ch_out_c_1"}, "to": {"component": "alice_memory", "port": "ch_in_c"}, "delay": 74},
    {"from": {"component": "eve_bell_measurement", "port": "ch_out_c_2"}, "to": {"component": "bob_correction", "port": "ch_in_es"}, "delay": 53},
    {"from": {"component": "bob_memory", "port": "ch_out_q"}, "to": {"component": "bob_correction", "port": "ch_in_q"}, "delay": 0},
    {"from": {"component": "bob_memory", "port": "ch_out_c"}, "to": {"component": "bob_correction", "port": "ch_in_memory"}, "delay": 0},
    {"from": {"component": "bob_correction", "port": "ch_out_memory"}, "to": {"component": "bob_memory", "port": "ch_in_c"}, "delay": 0},
    {"from": {"component": "alice_memory", "port": "ch_out_q"}, "to": {"component": "alice_probe", "port": "ch_in_q"}, "delay": 0},
    {"from": {"component": "bob_correction", "port": "ch_out_q"}, "to": {"component": "bob_probe", "port": "ch_in_q"}, "delay": 0}
  ],
  "measurements": [
    {"type": "bell_fidelity", "probes": ["alice_probe", "bob_probe"]}
  ]
}
